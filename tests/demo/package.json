{
	"name": "demo-sk3",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "PUBLIC_SENTRY_ENABLED=false SENTRY_DISABLE_UPLOAD=true vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"build:swa": "PUBLIC_SWA_CLI=true vite build",
		"swa": "swa start",
		"test:swa": "PLAYWRIGHT_TARGET=swa playwright test",
		"test:preview": "PLAYWRIGHT_TARGET=preview playwright test",
		"test:azure": "PLAYWRIGHT_TARGET=azure playwright test",
		"coverage": "rm -rf ../../coverage-v8 func/coverage-v8 && NODE_V8_COVERAGE=../../coverage-v8 npm run test:swa && node --experimental-strip-types ./scripts/report-swa-coverage.ts"
	},
	"devDependencies": {
		"@azure/functions": "^4.17.0",
		"@azure/static-web-apps-cli": "^2.1.0",
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@ktarmyshov/svelte-adapter-azure-swa": "file:../..",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.64.1",
		"@sentry/api": "^0.395.0",
		"@storybook/addon-a11y": "^10.6.3",
		"@storybook/addon-docs": "^10.6.3",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.6.3",
		"@storybook/sveltekit": "^10.6.3",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"cookie": "^2.0.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.3",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"monocart-coverage-reports": "^3.0.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "^10.6.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true,
		"keytar": true
	},
	"dependencies": {
		"@sentry/sveltekit": "^11.9.0",
		"pg": "^8.23.1"
	},
	"engines": {
		"node": ">=22.17.0"
	}
}
