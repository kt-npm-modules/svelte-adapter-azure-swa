# Public SDK settings (compiled into the app). The existing demo DSN is the default.
# PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENABLED=true
PUBLIC_SENTRY_ENVIRONMENT=demo
# PUBLIC_SENTRY_RELEASE=<git-commit-or-release>

# Build-only credentials: put the actual token in the ignored .env.local file.
# E2E requires project:read plus org:ci for local build/upload.
# SENTRY_AUTH_TOKEN=
# SENTRY_DISABLE_UPLOAD=true

# Azure runtime selection is independent of the local build Node version.
NODE_API_RUNTIME=node:22

# External/Azure E2E must use the deployed PUBLIC_SENTRY_RELEASE and ENVIRONMENT.
