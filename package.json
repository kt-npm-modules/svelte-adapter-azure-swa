{
	"name": "@ktarmyshov/svelte-adapter-azure-swa",
	"description": "SvelteKit 3 adapter for Azure Static Web Apps with SSR, Azure Functions, and hybrid rendering.",
	"version": "3.0.1",
	"scripts": {
		"ci:all": "npm ci && npm ci --prefix tests/demo",
		"install:all": "npm install && npm install --prefix tests/demo",
		"build": "npm run gen:swa-config-ts",
		"build:release": "npm run build",
		"format": "prettier --write .",
		"format:all": "npm run format && npm run format --prefix tests/demo",
		"check": "tsc --project tsconfig.json --noEmit",
		"check:all": "npm run check && npm run check --prefix tests/demo",
		"lint": "prettier --check . && eslint .",
		"lint:all": "npm run lint && npm run lint --prefix tests/demo",
		"test": "vitest --run",
		"test:all": "npm run test && npm run test --prefix tests/demo",
		"coverage": "vitest --coverage --run",
		"changeset:version": "changeset version && npm run install:all && npm run format:all && git add --all",
		"changeset:publish": "changeset publish",
		"gen:swa-config-ts": "curl https://www.schemastore.org/staticwebapp.config.json | npx json-schema-to-typescript > ./src/types/swa-config-gen.d.ts && prettier --write ./src/types/swa-config-gen.d.ts",
		"clean:nm": "find . -type d -name node_modules -not -path '*/node_modules/*/node_modules' -prune -exec rm -rf '{}' +",
		"clean:nm:lock": "npm run clean:nm && find . -name 'package-lock.json' -type f -exec rm -rf '{}' +"
	},
	"main": "./src/index.js",
	"types": "./src/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.js"
		},
		"./package.json": "./package.json"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"sveltekit",
		"sveltekit-adapter",
		"sveltekit-3",
		"azure",
		"azure-static-web-apps",
		"azure-functions",
		"staticwebapp",
		"ssr",
		"serverless"
	],
	"homepage": "https://github.com/kt-npm-modules/svelte-adapter-azure-swa#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kt-npm-modules/svelte-adapter-azure-swa.git"
	},
	"bugs": {
		"url": "https://github.com/kt-npm-modules/svelte-adapter-azure-swa/issues"
	},
	"peerDependencies": {
		"@azure/functions": "^4.16.5",
		"@sveltejs/kit": "^3.1.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"json-schema-to-typescript": "^16.0.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"es-toolkit": "^1.53.0",
		"rolldown": "^1.2.15",
		"rolldown-plugin-sourcemaps": "^0.1.2",
		"set-cookie-parser": "^3.2.1"
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=22.17.0"
	},
	"allowScripts": {
		"fsevents": true
	}
}
